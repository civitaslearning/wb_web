---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import LogoBand from '../components/LogoBand.astro';
const roles = ['President / Provost', 'Enrollment leader', 'Student success leader', 'Advisor', 'IR / IE', 'CIO / IT', 'Faculty', 'Other'];
---
<Base title="Contact Us" description="Explore what Civitas Learning can bring to your institution.">
  <PageHero eyebrow="Contact" title="Explore what Civitas Learning can bring to your institution." sub="Tell us what you are trying to move. We reply within one business day." crumbs={[{ text: 'Home', href: '/' }, { text: 'Contact' }]} ctas={false} />
  <section><div class="wrap">
    <div class="grid2" style="align-items:start">
      <form class="form" data-demo>
        <div class="two"><label>First name<input required /></label><label>Last name<input required /></label></div>
        <label>Work email<input type="email" required placeholder="you@institution.edu" /></label>
        <div class="two"><label>Institution<input required /></label><label>Role<select>{roles.map((r) => <option>{r}</option>)}</select></label></div>
        <label>What are you trying to move?<textarea rows="4" placeholder="Retention, completion, course demand, a board question…"></textarea></label>
        <button class="btn btn-primary" type="submit">Book a demo</button>
        <small>Prototype form — nothing is sent.</small>
        <small class="ok" hidden style="color:var(--cyan-ink);font-weight:700">Thanks. A member of the team will be in touch.</small>
      </form>
      <div style="display:grid;gap:22px">
        <div class="card"><h3>Current partners</h3><p>Open a ticket in the <a href="https://support.civitaslearning.com/">Customer Support Portal</a> or see <a href="/support/">Technical Support</a>.</p></div>
        <div class="card"><h3>Phone</h3><p><a href="tel:512-692-7175">512-692-7175</a></p></div>
        <div class="card"><h3>Office</h3><p>6705 W Highway 290, Suite 607 PMB 1205<br />Austin, TX 78735-8407</p></div>
      </div>
    </div>
  </div></section>
  <LogoBand />
</Base>
<script>
  document.querySelectorAll<HTMLFormElement>('form[data-demo]').forEach((f) =>
    f.addEventListener('submit', (e) => { e.preventDefault(); f.querySelector<HTMLElement>('small.ok')!.hidden = false; })
  );
</script>
