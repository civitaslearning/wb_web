---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import LogoBand from '../components/LogoBand.astro';
import HubSpotForm from '../components/HubSpotForm.astro';
---
<Base title="Contact Us" description="Explore what Civitas Learning can bring to your institution.">
  <PageHero eyebrow="Contact" title="Explore what Civitas Learning can bring to your institution." sub="Ready to advance your institutional goals? Complete the form and our team will reach out to start the conversation." crumbs={[{ text: 'Home', href: '/' }, { text: 'Contact' }]} ctas={false} />
  <section><div class="wrap">
    <div class="grid2" style="align-items:start">
      <div class="card form-card">
        <h3>Book a demo</h3>
        <p>Tell us what you are trying to move. We reply within one business day.</p>
        <HubSpotForm form="contact" id="contact-form" />
      </div>
      <div style="display:grid;gap:22px">
        <div class="card"><h3>Need technical support?</h3><p>Current partners can email <a href="mailto:support@civitaslearning.com">support@civitaslearning.com</a>, open a ticket in the <a href="https://support.civitaslearning.com/">Customer Support Portal</a>, or see <a href="/support/">Technical Support</a>.</p></div>
        <div class="card"><h3>Looking for partner resources?</h3><p>Visit the <a href="https://docs.civitaslearning.com/">Civitas Learning Hub</a> for product documentation and release notes.</p></div>
        <div class="card"><h3>Phone</h3><p><a href="tel:512-692-7175">512-692-7175</a></p></div>
        <div class="card"><h3>Office</h3><p>6705 W Highway 290, Suite 607 PMB 1205<br />Austin, TX 78735-8407</p></div>
      </div>
    </div>
  </div></section>
  <LogoBand />
</Base>
