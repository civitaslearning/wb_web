---
/**
 * Solution and use-case pages. One route, driven by src/data/solutions.json,
 * so /platform/, /analytics/, /enrollment-management/ … all share this template.
 */
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Sections from '../components/Sections.astro';
import Quotes from '../components/Quotes.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import solutions from '../data/solutions.json';
import faqs from '../data/faqs.json';
import { breadcrumbs, softwareApplication, type FaqItem } from '../lib/schema';

export function getStaticPaths() {
  return solutions.map((p) => ({ params: { slug: p.slug }, props: p }));
}
const p = Astro.props;
// "Use Cases" points at the hub, not at one of the use cases.
const root = p.kind === 'solutions' ? { text: 'Solutions', href: '/platform/' } : { text: 'Use Cases', href: '/use-cases/' };
const path = `/${p.slug}/`;
const crumbs = [{ text: 'Home', href: '/' }, root, { text: p.name }];
// Buyer questions for this page, with FAQPage data. A page with no entry in
// faqs.json renders no block; add the questions there, not here.
const faqItems: FaqItem[] = (faqs as Record<string, FaqItem[]>)[path] ?? [];
const jsonld: object[] = [breadcrumbs(crumbs, path)];
if (p.slug === 'platform') jsonld.push(softwareApplication());
const extraIntegrations = ['PeopleSoft', 'Workday', 'Slate', 'Element451', 'CollegeVine', '+ 100 more'];
// The institutional scoreboard. Every use-case page shows the same six
// outcomes, so a reader sees the whole institution, not one office.
const outcomes = [
  { slug: 'enrollment-management', label: 'Enroll', line: 'Yield, melt, registration' },
  { slug: 'academic-leaders-and-faculty', label: 'Engage', line: 'Course-level engagement, section fill' },
  { slug: 'advising-and-student-success', label: 'Persist', line: 'Retention, term to term' },
  { slug: 'improve-on-time-completion', label: 'Graduate', line: 'On-time completion' },
  { slug: 'career-outcomes', label: 'Employ', line: 'Career readiness, graduate earnings' },
  { slug: 'ensure-initiative-efficacy-and-roi', label: 'Prove', line: 'Lift vs. a comparison group' },
];
---
<Base title={p.name} description={p.sub || p.headline} jsonld={jsonld}>
  <PageHero eyebrow={p.eyebrow} title={p.headline} sub={p.sub} crumbs={crumbs} />
  {'video' in p && p.video && (
    <section class="tight video-sec"><div class="wrap">
      <div class="embed video"><iframe src={`https://www.youtube-nocookie.com/embed/${p.video.youtube}`} title={p.video.title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div>
      {p.video.caption && <p class="video-cap">{p.video.caption}</p>}
    </div></section>
  )}
  <Sections sections={p.sections} />
  {p.kind === 'usecases' && (
    <section class="tight"><div class="wrap">
      <div class="outcomes-head">
        <div><span class="eyebrow">The institutional scoreboard</span><h2>Every office gets a number. This page is one of six.</h2></div>
        <p>Enrollment, engagement, persistence, graduation, and career outcomes, each measured against a comparison group. The same data, the same model, one ledger for the cabinet, the board, and the Department of Education.</p>
      </div>
      <div class="outcomes">
        {outcomes.map((o) => (
          <a class:list={['outcome', { cur: o.slug === p.slug }]} href={`/${o.slug}/`} aria-current={o.slug === p.slug ? 'page' : undefined}>
            <b>{o.label}</b><span>{o.line}</span>
          </a>
        ))}
      </div>
    </div></section>
  )}
  {p.stats.length > 0 && (
    <section class="tint tight"><div class="wrap">
      <span class="eyebrow">Partner outcomes</span>
      <div class="grid4" style="margin-top:18px">
        {p.stats.map((s) => <div class="card"><div class="n">{s.value}</div><div class="m">{s.metric}</div></div>)}
      </div>
    </div></section>
  )}
  {p.integrations.length > 0 && (
    <section class="tight"><div class="wrap">
      <span class="eyebrow">Runs beside</span>
      <div class="filters" style="margin-top:14px">{[...p.integrations, ...extraIntegrations].map((x) => <span class="chip">{x}</span>)}</div>
    </div></section>
  )}
  <section class="tight"><div class="wrap security-line">
    <span class="eyebrow">Your data stays yours</span>
    <p>Civitas works under FERPA as a school official you designate, with a published data sharing agreement and platform specifications. Accessibility conformance reports are available on request. <a href="/security/">Security and privacy →</a></p>
  </div></section>
  <Quotes items={p.testimonials} />
  <Faq items={faqItems} heading={`Questions institutions ask about ${p.eyebrow.split('·')[0].trim().toLowerCase()}`} />
  <FinalCta />
</Base>
