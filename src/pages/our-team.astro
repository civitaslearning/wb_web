---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import FinalCta from '../components/FinalCta.astro';
import team from '../data/team.json';
---
<Base title="Leadership Team" description="The Civitas Learning leadership team.">
  <PageHero eyebrow="Leadership team" title="People who have run the systems you run." sub="More than 100 years of combined higher-education experience across the leadership team." crumbs={[{ text: 'Home', href: '/' }, { text: 'Company', href: '/about/' }, { text: 'Leadership Team' }]} ctas={false} />
  <section><div class="wrap">
    <div class="team">{team.map((p) => <div class="person"><img src={`/assets/${p.file}`} alt={p.name} /><h3>{p.name}</h3><div class="t">{p.title}</div><p>{p.bio}</p></div>)}</div>
  </div></section>
  <FinalCta />
</Base>
