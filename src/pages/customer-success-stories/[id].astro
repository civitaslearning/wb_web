---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import StoryCard from '../../components/StoryCard.astro';
import FinalCta from '../../components/FinalCta.astro';
import RelatedUseCase from '../../components/RelatedUseCase.astro';
import { pageForLabel } from '../../lib/usecases';

export async function getStaticPaths() {
  const stories = await getCollection('stories');
  return stories.map((s) => ({ params: { id: s.id }, props: { story: s } }));
}
const { story } = Astro.props;
const d = story.data;
const { Content } = await render(story);
const used = d.solutions.map((x) => ({ text: x, page: pageForLabel(x) }));
const fits = [
  { text: d.headline, weight: 4 },
  { text: d.outcomes.map((o) => o.metric).join(' '), weight: 3 },
  { text: d.summary, weight: 2 },
  { text: story.body || '', weight: 0.25 },
];
const who = d.institution || 'Civitas Learning partner';
const others = (await getCollection('stories')).filter((s) => s.id !== story.id).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
---
<Base title={`${who} — Customer Story`} description={d.summary} seoTitle={d.seoTitle} image={d.image} noindex={d.noindex} type="article" published={d.date} modified={d.updated}>
  <section class="phero story-hero"><div class="wrap">
    <div>
      <div class="crumbs"><a href="/">Home</a> / <a href="/customer-success-stories/">Customer Stories</a> / {who}</div>
      <span class="eyebrow">{d.type}</span>
      <h1 style="margin-top:12px">{d.headline}</h1>
      <p class="sub">{d.summary}</p>
    </div>
    {d.logo && <div class="logo-box"><img src={`/assets/${d.logo}`} alt={d.institution} /></div>}
  </div></section>
  <section><div class="wrap story-body">
    <div class="prose article">
      {d.image && !d.logo && <img class="post-hero-img" style="margin:0 0 28px" src={d.image} alt={d.imageAlt || who} />}
      <Content />
      {d.quote && (
        <>
          <h2>In their words</h2>
          <div class="quote"><blockquote>“{d.quote.text}”</blockquote><cite><b>{d.quote.name}</b>{d.quote.title}</cite></div>
        </>
      )}
      {d.solutions.length > 0 && (
        <>
          <h2>Solutions used</h2>
          <div class="filters">{used.map((u) => u.page ? <a class="chip" href={`/${u.page.slug}/`} title={u.page.headline}>{u.text}</a> : <span class="chip">{u.text}</span>)}</div>
        </>
      )}
    </div>
    <aside class="aside">
      {d.outcomes.length > 0 && <span class="eyebrow">Outcomes</span>}
      {d.outcomes.slice(0, 4).map((o) => <div class="card"><div class="n">{o.value}</div><div class="m">{o.metric}</div></div>)}
      <RelatedUseCase texts={fits} />
      <a class="btn btn-primary" href="/contact/">See this at your institution</a>
    </aside>
  </div></section>
  <section class="tint"><div class="wrap">
    <span class="eyebrow">More partner stories</span>
    <div class="grid3" style="margin-top:22px">{others.map((s) => <StoryCard story={s} />)}</div>
  </div></section>
  <FinalCta />
</Base>

<style is:global>
  .story-body .prose h2:first-child { margin-top: 0; }
</style>
