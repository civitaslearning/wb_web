---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---
<Base title="Signals Newsletter" description="One email a month: the numbers behind student success, enrollment, and institutional effectiveness.">
  <PageHero eyebrow="Signals newsletter" title="Signals: what the data says this month." sub="One email a month. The numbers behind student success, enrollment, and institutional effectiveness — and what partners did about them." crumbs={[{ text: 'Home', href: '/' }, { text: 'Resources', href: '/resources/' }, { text: 'Subscribe' }]} ctas={false} />
  <section><div class="wrap" style="max-width:640px">
    <form class="form" data-demo>
      <label>Work email<input type="email" required placeholder="you@institution.edu" /></label>
      <button class="btn btn-primary" type="submit">Subscribe</button>
      <small>Prototype form — nothing is sent.</small>
      <small class="ok" hidden style="color:var(--cyan-ink);font-weight:700">Subscribed.</small>
    </form>
  </div></section>
</Base>
<script>
  document.querySelectorAll<HTMLFormElement>('form[data-demo]').forEach((f) =>
    f.addEventListener('submit', (e) => { e.preventDefault(); f.querySelector<HTMLElement>('small.ok')!.hidden = false; })
  );
</script>
