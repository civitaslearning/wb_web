---
import Base from '../layouts/Base.astro';
import LogoBand from '../components/LogoBand.astro';
import FinalCta from '../components/FinalCta.astro';
---
<Base title="Civitas Learning" description="AI built on your data. Outcomes you can prove. Civitas Learning connects the systems you already run into one model of your institution and measures the impact of every decision.">
  <header class="hero">
    <div class="wrap">
      <div class="hero-copy">
        <span class="eyebrow">Institutional effectiveness · Proven, not promised</span>
        <h1>Every vendor sells AI.<br />We prove what works.</h1>
        <p class="sub">
          Civitas Learning connects the data already in <b>Banner, PeopleSoft, Workday, Slate, Canvas, Salesforce — and 100+ other systems</b> into one model of your institution, trains AI on it, and <b>measures the impact of every decision</b> — so you can show your board what moved the numbers, and stop paying for what didn't.
        </p>
      </div>
      <div class="ledger" aria-label="Example intervention impact ledger">
        <div class="ledger-head"><h3>Intervention impact, Fall cohort</h3><span class="mono">example · n = 6,412</span></div>
        <p class="ledger-sub">Persistence lift vs. matched students who did not receive the intervention. 95% confidence shown.</p>
        <div class="rows" id="rows"></div>
        <div class="legend"><span class="l1"><i></i>Measured lift</span><span class="l2"><i></i>Not significant</span><span class="l3"><i></i>95% confidence interval</span></div>
      </div>
    </div>
  </header>

  <section id="roi" class="tint tight">
    <div class="wrap">
      <div class="sec-head">
        <div><span class="eyebrow">Run the numbers</span><h2>What is one point of retention worth to you?</h2></div>
        <p>Start with your institution's own IPEDS figures, then move the slider.</p>
      </div>
      <div class="calc">
        <div class="finder">
          <label for="inst">Find your institution</label>
          <div class="finder-box">
            <input type="search" id="inst" placeholder="Type a college or university name" autocomplete="off" spellcheck="false" aria-autocomplete="list" aria-controls="instList" aria-expanded="false" />
            <ul class="finder-list" id="instList" role="listbox" hidden></ul>
          </div>
          <p class="finder-picked" id="instPicked" hidden></p>
        </div>
        <div class="fields">
          <label>Fall undergraduate headcount<input type="number" id="hc" value="9000" min="200" step="100" /></label>
          <label>Net price per student, per year<input type="number" id="tu" value="11500" min="1000" step="250" /></label>
          <label><span>Retention lift <span class="mono" id="liftLbl">3.0 pts</span> <span style="color:var(--ink3);font-weight:400">— partners typically see 3–11 pts</span></span><input type="range" id="lift" min="1" max="11" step="0.5" value="3" /></label>
        </div>
        <div class="out">
          <div class="bench" id="bench" hidden>
            <div class="bench-row"><b id="bRet">—</b><span>first-year retention<small>institutions like yours: <b id="bRetP">—</b></small></span></div>
            <div class="bench-row"><b id="bGrad">—</b><span><span id="bGradLbl">graduation rate</span><small>institutions like yours: <b id="bGradP">—</b></small></span></div>
            <p class="bench-msg" id="bMsg"></p>
          </div>
          <div><div class="big" id="rev">$—</div><div class="lbl">additional net revenue per year, from students retained</div></div>
          <div class="line"><span>Students retained who would have left</span><b id="stu">—</b></div>
          <p class="note" id="calcNote">Assumes one additional year of net price per retained student. Multi-year and state funding effects are excluded, so this is a floor.</p>
        </div>
        <div class="cta-row">
          <a class="btn btn-primary" href="/contact/">Book a demo</a>
          <a class="btn btn-ghost" href="/customer-success-stories/">See partner outcomes</a>
        </div>
      </div>
    </div>
  </section>

  <LogoBand />

  <div class="stats">
    <div class="wrap">
      <div class="stat"><div class="n">375<em>+</em></div><div class="l">colleges and universities on the platform</div></div>
      <div class="stat"><div class="n">89<em>%</em></div><div class="l">accuracy predicting student outcomes, on your data</div></div>
      <div class="stat"><div class="n"><em>+</em>8 pts</div><div class="l">retention, Northwest Missouri State University</div></div>
      <div class="stat"><div class="n">$4<em>:</em>$1</div><div class="l">returned on every dollar partners invest</div></div>
    </div>
  </div>

  <section id="platform">
    <div class="wrap">
      <div class="sec-head">
        <div><span class="eyebrow">One institution · one dataset</span><h2>Your systems already hold the answer. They just don't talk to each other.</h2></div>
        <p><b>An operating system runs the work. Civitas proves the work paid off.</b> Civitas sits beside the systems you run today — more than 100 of them, including the AI agent and CRM tools you may already have bought. It reads from all of them, builds one model of the institution, and writes actions and results back — for student success first, and for every other question the cabinet asks.</p>
      </div>
      <div class="flow">
        <div class="flow-col">
          <div class="flow-lbl">Systems you keep · 100+ integrations</div>
          <div class="sys"><b>SIS</b><span>Banner · PeopleSoft · Colleague · Workday Student</span></div>
          <div class="sys"><b>LMS</b><span>Canvas · Blackboard · D2L · Moodle</span></div>
          <div class="sys"><b>CRM</b><span>Slate · Salesforce · Element451 · CollegeVine · TargetX</span></div>
          <div class="sys"><b>HR &amp; finance</b><span>Workday · Oracle · Ellucian</span></div>
          <div class="sys"><b>Everything else</b><span>Your warehouse, engagement tools, card swipes, surveys — 100+ systems and counting</span></div>
        </div>
        <div class="flow-arrow" aria-hidden="true"><span></span></div>
        <div class="flow-col core">
          <div class="flow-lbl">Civitas</div>
          <div class="core-box">
            <div class="step"><b>Unify</b><span>One student, one course, one program record across every system.</span></div>
            <div class="step"><b>Predict</b><span>Models trained on your history, refreshed each term.</span></div>
            <div class="step"><b>Act</b><span>AI agents work inside the tools your staff already open.</span></div>
            <div class="step"><b>Measure</b><span>Every action scored against a matched comparison group.</span></div>
          </div>
        </div>
        <div class="flow-arrow" aria-hidden="true"><span></span></div>
        <div class="flow-col">
          <div class="flow-lbl">Outcomes you report</div>
          <div class="sys out-lead"><b>Student success</b><span>Persistence, completion, time to degree — proven at 375 institutions</span></div>
          <div class="sys"><b>Enrollment</b><span>Yield, melt, registration</span></div>
          <div class="sys"><b>Academic planning</b><span>Course demand, section fill, program ROI</span></div>
          <div class="sys"><b>Finance</b><span>Net tuition, aid leverage, cost to serve</span></div>
          <div class="sys"><b>Accountability</b><span>Board, accreditor, and state reporting</span></div>
        </div>
      </div>
      <div class="cta-row" style="margin-top:28px">
        <a class="btn btn-ghost" href="/platform/">Explore the platform →</a>
        <a class="btn btn-ghost" href="/customer-success-stories/from-a-year-of-frustration-to-live-in-six-weeks-lawrence-technological-universitys-deployment-story/">Live in six weeks at Lawrence Tech →</a>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="sec-head">
        <div><span class="eyebrow">The questions your cabinet will ask</span><h2>Any tool can send a message. Few can tell you if it changed anything.</h2></div>
        <p>Performance-based funding, tighter budgets, and AI on every vendor slide. Before you sign, get answers to three questions.</p>
      </div>
      <div class="qs">
        <div class="q"><span class="tag">Question 1</span><h3>Are the predictions built on our students?</h3><p class="a">Models trained on national averages miss the pattern that matters at <b>your</b> institution — the 14-credit part-timer, the transfer with a math gap. <b>Civitas trains a model per institution</b>, from your SIS, LMS, and CRM history.</p></div>
        <div class="q"><span class="tag">Question 2</span><h3>Which interventions are really working?</h3><p class="a">Only 40–60% of student success initiatives produce a measurable outcome. <b>Civitas measures each one</b> against a matched comparison group, so you fund what works and retire what doesn't.</p></div>
        <div class="q"><span class="tag">Question 3</span><h3>Do we know what AI does on our behalf?</h3><p class="a">Every agent action is logged, attributed, and reviewable. <b>Your staff set the guardrails</b>; the agent works inside them, and the audit trail is yours.</p></div>
      </div>
    </div>
  </section>

  <section id="jobs">
    <div class="wrap">
      <div class="sec-head">
        <div><span class="eyebrow">The lead use case · student success</span><h2>AI agents that do the work — and a ledger that proves it paid off.</h2></div>
        <p>Student success is where 375 institutions have proved the platform. Each agent acts on your institution's own predictions, inside the systems your teams already use, and reports its impact back to the same ledger.</p>
      </div>
      <div class="jobs">
        <div class="job"><span class="stage">Recruit &amp; enroll</span><h3>Fill the class with students who will finish.</h3><p>Every admit gets two scores in the CRM your counselors already open: will they enroll, and will they still be here in year two. Counselors work the list from the top. The agent works the rest.</p>
          <ul class="agents"><li><span>agent</span><span><b>Yield agent</b> — drafts the outreach, books the follow-up, and logs it in the CRM the day an admit goes quiet.</span></li><li><span>agent</span><span><b>Registration agent</b> — finds the continuing student who has not registered by week two of open registration, names the hold, and clears it with them.</span></li></ul>
          <p class="proof"><b>+3.7%</b> registration, SUNY Broome · <a href="/enrollment-management/">Strategic enrollment →</a></p></div>
        <div class="job"><span class="stage">Success &amp; progress</span><h3>Keep the students you already have.</h3><p>Retention is the cheapest enrollment you will ever buy. A model trained on your own history scores every student every week, so the advisor sees the week-four slide before it becomes a week-twelve withdrawal.</p>
          <ul class="agents"><li><span>agent</span><span><b>Advising agent</b> — builds each advisor's list for the day, drafts the note, and books the meeting before the student misses a second class.</span></li><li><span>agent</span><span><b>Care coordination agent</b> — turns an advising alert, an aid hold, and a tutoring referral into one case with one owner, so the student hears one version of the plan.</span></li></ul>
          <p class="proof"><b>+8 pts</b> retention, Northwest Missouri State · <a href="/advising-and-student-success/">Advising →</a></p></div>
        <div class="job"><span class="stage">Graduate &amp; employ</span><h3>Move students to the finish line, and past it.</h3><p>Thirty credits from a degree is where students stall on one course. The completion agent finds them by name, the term before it happens.</p>
          <ul class="agents"><li><span>agent</span><span><b>Completion agent</b> — flags the senior whose plan is blocked by one section, then fixes the plan or finds the seat.</span></li><li><span>agent</span><span><b>Outcomes agent</b> — tracks graduate employment and reports it back to programs and IR, so program review starts with a number.</span></li></ul>
          <p class="proof"><b>+5%</b> graduation rate, Texas A&amp;M–San Antonio · <a href="/improve-on-time-completion/">Completion →</a></p></div>
      </div>
      <div class="beyond">
        <div class="beyond-head"><span class="eyebrow">Beyond the student journey</span><p>Every office gets a scoreboard, not just an agent. The same data, models, and ledger answer the rest of the cabinet's questions.</p></div>
        <div class="beyond-grid">
          <div class="b"><b>Course demand &amp; scheduling</b><span>Predict section fill by term. Open the sections students need and close the ones they don't.</span></div>
          <div class="b"><b>Program portfolio</b><span>Enrollment, completion, and cost per program in one view, so investment follows evidence.</span></div>
          <div class="b"><b>Financial aid leverage</b><span>Find where one more aid dollar changes a yield or persistence decision — and where it doesn't.</span></div>
          <div class="b"><b>Institutional research</b><span>One governed dataset for IPEDS, accreditation, and board reporting, with the intervention record attached.</span></div>
        </div>
      </div>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap">
      <div class="sec-head">
        <div><span class="eyebrow">Why the data matters</span><h2>Generic AI knows higher ed. Civitas knows <em style="font-style:italic">your</em> students.</h2></div>
        <p>An agent is only as good as the prediction behind it. Here is the difference between a model trained on the sector and a model trained on you.</p>
      </div>
      <div class="cmp">
        <div class="col"><h3>Generic AI agent <small>sector model</small></h3><ul>
          <li><i>—</i><span><b>Predictions</b> from national benchmarks or one vendor's pooled customer base.</span></li>
          <li><i>—</i><span><b>Risk flags</b> from rules: a slipping GPA, a missed registration, an unopened email.</span></li>
          <li><i>—</i><span><b>Proof</b> is activity: open rates, reply rates, hours saved, "exceeded expectations".</span></li>
          <li><i>—</i><span><b>Scope</b> is the front door: marketing, admissions, inquiry response.</span></li></ul></div>
        <div class="col"><h3>Civitas Learning <small>your model</small></h3><ul>
          <li><i>✓</i><span><b>Predictions</b> from a model trained on your SIS, LMS, and CRM history — refreshed each term.</span></li>
          <li><i>✓</i><span><b>Risk flags</b> from a model trained on your history: grades, credits, course patterns, aid status, and engagement together.</span></li>
          <li><i>✓</i><span><b>Proof</b> is outcome: persistence, completion, and revenue lift vs. a matched comparison group.</span></li>
          <li><i>✓</i><span><b>Scope</b> is the whole institution: enroll, persist, graduate, employ — and the courses, programs, and budgets behind them.</span></li></ul></div>
      </div>
    </div>
  </section>

  <section id="proof" style="padding-top:0">
    <div class="wrap">
      <div class="sec-head">
        <div><span class="eyebrow">Partner outcomes</span><h2>Numbers a president can put in front of a board.</h2></div>
        <p>Published results from Civitas partners: 31 stories, each with the number and how it was measured. Every figure is measured against a comparison group, not a prior year. <a href="/customer-success-stories/">See all 31 →</a></p>
      </div>
      <div class="grid4">
        <a class="card link" href="/customer-success-stories/from-81-to-86-4-srus-playbook-for-sustained-retention-gains/"><div class="n">86.4%</div><div class="m">first-year retention, up from 81% — highest in SRU history</div><div class="who">Slippery Rock University<small>Read the playbook →</small></div></a>
        <a class="card link" href="/customer-success-stories/coordination-without-control-how-the-university-of-cincinnati-built-a-student-success-system-that-scales/"><div class="n">+7 pts</div><div class="m">graduation rate across 18 decentralized units</div><div class="who">University of Cincinnati<small>Read the story →</small></div></a>
        <a class="card link" href="/customer-success-stories/austin-community-college-persistence/"><div class="n">+4.1%</div><div class="m">fall-to-spring persistence; +13% two-year completion</div><div class="who">Austin Community College<small>Read the story →</small></div></a>
        <a class="card link" href="https://studentimpactreport.civitaslearning.com/2026"><div class="n">$4:$1</div><div class="m">average return across partners, 220 initiatives, five years of data</div><div class="who">2026 Student Success Impact Report<small>Read the methodology →</small></div></a>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap quote big">
      <span class="eyebrow">Strategic partnership</span>
      <blockquote style="margin-top:14px">“The service during integration is beyond expected. I've never felt we're just a number.”</blockquote>
      <cite style="margin-top:16px"><b>Erin Gunnell</b>Director of Success Advising &amp; Tutoring, Ensign College</cite>
    </div>
  </section>

  <FinalCta />
</Base>

<script>
  // Example impact ledger. Scale: 0 to +6 pts across 90% of track width (zero line at 8%).
  const data = [
    { name: 'Emergency aid + advisor follow-up', n: 'n = 412', lo: 2.6, mid: 4.1, hi: 5.6 },
    { name: 'Proactive advising outreach', n: 'n = 2,180', lo: 2.1, mid: 3.4, hi: 4.7 },
    { name: 'Tutoring referral, gateway math', n: 'n = 966', lo: 0.8, mid: 1.9, hi: 3.0 },
    { name: 'Early alert, no follow-up', n: 'n = 1,540', lo: -0.7, mid: 0.2, hi: 1.1 },
    { name: 'Generic nudge campaign', n: 'n = 1,314', lo: -0.9, mid: -0.1, hi: 0.7 },
  ];
  const max = 6, base = 8, span = 90;
  const x = (v: number) => base + (Math.max(-0.8, v) / max) * span;
  const host = document.getElementById('rows')!;
  for (const d of data) {
    const sig = d.lo > 0;
    const row = document.createElement('div');
    row.className = 'row';
    const v = d.mid >= 0 ? '+' + d.mid.toFixed(1) : d.mid.toFixed(1);
    row.innerHTML =
      `<div class="name">${d.name}<small class="mono">${d.n}</small></div>` +
      `<div class="track"><span class="zero"></span><span class="bar${sig ? '' : ' flat'}" data-w="${(Math.max(0, d.mid) / max) * span}"></span>` +
      `<span class="ci" style="left:${x(d.lo)}%;width:${x(d.hi) - x(d.lo)}%"></span></div>` +
      `<div class="val ${sig ? 'lift' : 'flat'}">${v} pts</div>`;
    host.appendChild(row);
  }
  requestAnimationFrame(() => requestAnimationFrame(() => {
    host.querySelectorAll<HTMLElement>('.bar').forEach((b) => (b.style.width = b.dataset.w + '%'));
  }));

  // ROI calculator
  const hc = document.getElementById('hc') as HTMLInputElement;
  const tu = document.getElementById('tu') as HTMLInputElement;
  const lift = document.getElementById('lift') as HTMLInputElement;
  const fmt = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
  function calc() {
    const h = +hc.value || 0, t = +tu.value || 0, l = +lift.value || 0;
    const s = Math.round((h * l) / 100);
    document.getElementById('liftLbl')!.textContent = l.toFixed(1) + ' pts';
    document.getElementById('stu')!.textContent = s.toLocaleString('en-US');
    document.getElementById('rev')!.textContent = fmt(s * t);
  }
  [hc, tu, lift].forEach((el) => el.addEventListener('input', calc));
  calc();

  // Institution finder. Loads public/data/ipeds.json on first use and fills the
  // calculator with real IPEDS figures. Peers are the 40 institutions with the
  // same control (public, private nonprofit, for-profit) and Carnegie group
  // nearest in undergraduate headcount, Pell share, and net price. The peer
  // list is never shown.
  type Row = [number, string, string, string, number, number, number | null, number | null, number | null, number | null, number];
  const inst = document.getElementById('inst') as HTMLInputElement;
  const list = document.getElementById('instList') as HTMLUListElement;
  const picked = document.getElementById('instPicked')!;
  const bench = document.getElementById('bench')!;
  const $ = (id: string) => document.getElementById(id)!;
  let rows: Row[] = [];
  let loading: Promise<void> | null = null;
  let active = -1;

  function load() {
    if (loading) return loading;
    const base = document.querySelector('a.brand')?.getAttribute('href') || '/';
    loading = fetch(base.replace(/\/?$/, '/') + 'data/ipeds.json')
      .then((r) => r.json())
      .then((d) => { rows = d.rows; });
    return loading;
  }

  function matches(q: string): Row[] {
    const terms = q.toLowerCase().split(/\s+/).filter(Boolean);
    if (!terms.length) return [];
    const out: Row[] = [];
    for (const r of rows) {
      const hay = (r[1] + ' ' + r[2] + ' ' + r[3]).toLowerCase();
      if (terms.every((t) => hay.includes(t))) { out.push(r); if (out.length >= 8) break; }
    }
    return out;
  }

  function render(items: Row[]) {
    list.innerHTML = '';
    active = -1;
    for (const r of items) {
      const li = document.createElement('li');
      li.setAttribute('role', 'option');
      li.innerHTML = `<b>${r[1]}</b><small>${r[2]}, ${r[3]}</small>`;
      li.addEventListener('mousedown', (e) => { e.preventDefault(); choose(r); });
      list.appendChild(li);
    }
    list.hidden = items.length === 0;
    inst.setAttribute('aria-expanded', String(items.length > 0));
  }

  function median(v: number[]) {
    const s = v.slice().sort((a, b) => a - b);
    return s.length ? (s.length % 2 ? s[(s.length - 1) / 2] : (s[s.length / 2 - 1] + s[s.length / 2]) / 2) : NaN;
  }

  function peers(r: Row): Row[] {
    const control = (s: number) => ((s - 1) % 3) + 1;
    let same = rows.filter((x) => x[0] !== r[0] && control(x[4]) === control(r[4]) && x[10] === r[10] && r[10] > 0);
    if (same.length < 40) same = rows.filter((x) => x[0] !== r[0] && x[4] === r[4]);
    const dist = (x: Row) => {
      const size = Math.abs(Math.log(x[5]) - Math.log(r[5]));
      const pell = r[9] != null && x[9] != null ? Math.abs(x[9] - r[9]) / 25 : 0.5;
      const price = r[8] != null && x[8] != null ? Math.abs(Math.log(x[8]) - Math.log(r[8])) : 0.5;
      return size + pell + price;
    };
    return same.map((x) => [dist(x), x] as [number, Row]).sort((a, b) => a[0] - b[0]).slice(0, 40).map((p) => p[1]);
  }

  function choose(r: Row) {
    inst.value = r[1];
    list.hidden = true;
    inst.setAttribute('aria-expanded', 'false');
    picked.hidden = false;
    picked.textContent = `${r[1]}, ${r[2]}, ${r[3]} · IPEDS 2023–24`;
    hc.value = String(r[5]);
    if (r[8]) tu.value = String(r[8]);

    const p = peers(r);
    const retVals = p.map((x) => x[6]).filter((x): x is number => x != null);
    const retP = retVals.length ? Math.round(median(retVals)) : NaN;
    const gradVals = p.map((x) => x[7]).filter((x): x is number => x != null);
    const gradP = gradVals.length ? Math.round(median(gradVals)) : NaN;
    $('bRet').textContent = r[6] != null ? r[6] + '%' : 'n/a';
    $('bRetP').textContent = isNaN(retP) ? 'n/a' : retP + '%';
    $('bGradLbl').textContent = r[4] <= 3 ? '6-year graduation rate' : '3-year graduation rate';
    $('bGrad').textContent = r[7] != null ? r[7] + '%' : 'n/a';
    $('bGradP').textContent = isNaN(gradP) ? 'n/a' : gradP + '%';

    const gap = r[6] != null && !isNaN(retP) ? r[6] - retP : 0;
    const worth = (pts: number) => fmt(Math.round((r[5] * pts) / 100) * (+tu.value || 0));
    const pts = (n: number) => `${n} ${n === 1 ? 'point' : 'points'}`;
    let msg: string;
    if (r[6] == null || isNaN(retP)) {
      lift.value = '3';
      msg = `IPEDS does not report a first-year retention rate here. One point is worth ${worth(1)} a year.`;
    } else if (gap < 0) {
      lift.value = String(Math.min(11, Math.max(1, -gap)));
      msg = `${pts(-gap)} below institutions like yours. Closing that gap is worth ${worth(-gap)} a year.`;
    } else if (gap > 0) {
      lift.value = '3';
      msg = `${pts(gap)} above institutions like yours. Every point you hold is worth ${worth(1)} a year.`;
    } else {
      lift.value = '3';
      msg = `Level with institutions like yours. One point is worth ${worth(1)} a year.`;
    }
    $('bMsg').textContent = msg;
    bench.hidden = false;
    calc();
  }

  inst.addEventListener('focus', () => { load(); });
  inst.addEventListener('input', async () => {
    await load();
    render(matches(inst.value));
  });
  inst.addEventListener('keydown', (e) => {
    const items = list.querySelectorAll('li');
    if (!items.length || list.hidden) return;
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      active = (active + (e.key === 'ArrowDown' ? 1 : -1) + items.length) % items.length;
      items.forEach((li, i) => li.classList.toggle('active', i === active));
    } else if (e.key === 'Enter' && active >= 0) {
      e.preventDefault();
      (items[active] as HTMLElement).dispatchEvent(new MouseEvent('mousedown'));
    } else if (e.key === 'Escape') {
      list.hidden = true;
    }
  });
  inst.addEventListener('blur', () => { setTimeout(() => { list.hidden = true; }, 120); });
</script>
