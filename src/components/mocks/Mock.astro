---
import AdvisorQueue from './AdvisorQueue.astro';
import ImpactLedger from './ImpactLedger.astro';
import DataSources from './DataSources.astro';
interface Props { i: number }
const { i } = Astro.props;
const which = i % 3;
---
{which === 0 && <AdvisorQueue />}
{which === 1 && <ImpactLedger />}
{which === 2 && <DataSources />}
